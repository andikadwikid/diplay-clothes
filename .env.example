# Copy to `.env` to override the defaults used by docker-compose.yml.
# Every value below already has a working default, so this file is optional
# for a first local run. CHANGE ALL SECRETS before exposing this anywhere.

# --- Admin login (seeded into the database on startup; env is the source of truth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# --- JWT (HS256). At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me-before-deploying-0123456789
JWT_TTL=12h

# --- PostgreSQL
POSTGRES_USER=diplay
POSTGRES_PASSWORD=diplay_dev_password
POSTGRES_DB=diplay

# --- MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=diplay-media

# --- Uploads
MAX_UPLOAD_MB=5

# --- Stateless tier
# How many API replicas to run (the API keeps no state, so any number works).
BACKEND_REPLICAS=2

# --- Ports published on your machine
WEB_PORT=3000
MINIO_CONSOLE_PORT=9001
# Set to true only when served over HTTPS (marks the auth cookie Secure).
COOKIE_SECURE=false
